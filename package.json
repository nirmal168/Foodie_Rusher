{
  "name": "foodie-rusher-workspace",
  "version": "1.0.0",
  "description": "Professional workspace for Foodie Rusher",
  "scripts": {
    "install:all": "npm install && npm install --prefix backend && npm install --prefix frontend",
    "build": "npm run install:all && npm run build --prefix frontend",
    "start": "node backend/src/server.js",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:ai": "python backend/ai_services/setup_models.py && python backend/ai_services/ai_services/app.py",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\" \"npm run dev:ai\"",
    "seed:locations": "npm run seed:locations --prefix backend",
    "seed:test": "npm run seed:test --prefix backend"
  },
  "dependencies": {
    "concurrently": "^8.2.2"
  },
  "devDependencies": {
    "playwright": "^1.60.0"
  }
}
