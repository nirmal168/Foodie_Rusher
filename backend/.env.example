# Server Port configuration
PORT=5000

# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/food_delivery

# JWT security secret
JWT_SECRET=your_jwt_secret_key_here

# Nodemailer setup for email/OTP notifications (Gmail recommended)
EMAIL=your_email@gmail.com
PASS=your_email_app_password

# Allowed CORS origins in production (comma-separated, e.g. http://yourdomain.com,http://localhost:3000)
# Leave empty or omit to allow all origins in development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80

# Cloudinary Setup for Restaurant and Item Image Uploads
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
