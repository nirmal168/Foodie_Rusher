{
  "name": "foodie-rusher-workspace",
  "version": "1.0.0",
  "description": "Professional workspace for Foodie Rusher",
  "scripts": {
    "install:all": "npm install && npm install --prefix backend && npm install --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "seed:locations": "npm run seed:locations --prefix backend",
    "seed:test": "npm run seed:test --prefix backend"
  },
  "dependencies": {
    "concurrently": "^8.2.2"
  },
  "devDependencies": {
    "playwright": "^1.60.0"
  }
}
